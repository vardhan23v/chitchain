# ── chain ──────────────────────────────────────────────
MST_RPC_URL=https://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
DEPLOYER_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
RISK_ORACLE_PRIVATE_KEY=
# comma-separated; demo only (custodial demo wallets A–E, backend holds keys; the agent bids from them)
AGENT_WALLET_KEYS=
TREASURY_ADDRESS=
CHITCHAIN_ADDRESS=
START_BLOCK=

# ── ai (any OpenAI-compatible chat API; leave blank for the deterministic fallback:
#       desiredPayout → discount = pot − desiredPayout; urgency "high" → best + 5% of pot; riskTolerance "low" caps at 10%) ──
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.0-flash

# ── backend ────────────────────────────────────────────
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# PostgreSQL (required). Railway: reference the Postgres service's DATABASE_URL (internal URL, no SSL needed).
# External/public Postgres hosts usually need TLS: append ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chitchain
# explorer base used in /health (tx links = <EXPLORER>/tx/<hash>)
EXPLORER=https://testnet.mstscan.com
# optional: ENV_FILE=path/to/other.env makes the backend load that file instead of ../.env

# ── auth (v3: wallet-signature login, roles) ───────────
# HS256 secret for bearer sessions (>= 32 chars, e.g. `openssl rand -hex 32`). Required in production
# (NODE_ENV=production or on Railway); otherwise a random per-boot secret is used and logins do not survive a restart.
SESSION_SECRET=
# comma-separated wallet addresses that become ADMIN on login (promoted on later logins too)
PLATFORM_ADMIN_ADDRESSES=
# host shown in the sign-in message (defaults to the host of FRONTEND_ORIGIN)
AUTH_DOMAIN=
SESSION_TTL_SEC=86400
NONCE_TTL_SEC=300
# optional platform-admin PASSWORD fallback (for when the admin's wallet is unavailable). Enabled only when BOTH are set.
# Grants website admin rights only (session user = "admin:<username>", no wallet, cannot move funds).
# ADMIN_LOGIN_USER: 3–40 chars, lowercase letters/digits/._-   ADMIN_LOGIN_PASSWORD_HASH: `cd backend && npm run hash-password -- '<password>'`
ADMIN_LOGIN_USER=
ADMIN_LOGIN_PASSWORD_HASH=

# ── frontend ───────────────────────────────────────────
NEXT_PUBLIC_CHITCHAIN_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=91562037
NEXT_PUBLIC_RPC_URL=https://testnetrpc.mstblockchain.com
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_EXPLORER=https://testnet.mstscan.com

# ── ai bidding agent (v4) ──────────────────────────────
# backend: base URL of the Python CrewAI decision service (agent/, Railway service "ai-agent"). Empty = deterministic fallback only.
AI_AGENT_URL=
# agent/ service only (never needed by the Node backend): Groq key, Node backend base URL, LiteLLM model id
GROQ_API_KEY=
CHITCHAIN_API_URL=http://localhost:4000
MODEL=groq/qwen/qwen3.8-27b
