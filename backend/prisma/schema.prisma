// ChitChain backend schema (PostgreSQL). Tables/columns are snake_case via @@map/@map;
// the TypeScript row types in src/db/index.ts mirror those snake_case names.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Decoded contract events written by the indexer. (tx_hash, log_index) makes re-indexing idempotent.
model Event {
  id       Int    @id @default(autoincrement())
  circleId Int?   @map("circle_id")
  round    Int?
  name     String
  argsJson String @map("args_json")
  txHash   String @map("tx_hash")
  logIndex Int    @map("log_index")
  block    Int
  ts       Int

  @@unique([txHash, logIndex])
  @@index([circleId, id])
  @@index([name])
  @@map("events")
}

/// One row per agent decision (bid or skip) per member per round.
model AgentLog {
  id           Int     @id @default(autoincrement())
  circleId     Int     @map("circle_id")
  round        Int
  member       String
  agentWallet  String  @map("agent_wallet")
  bidThisRound Boolean @map("bid_this_round")
  discount     String // wei as decimal string (bigint-as-string convention)
  reason       String
  source       String // "llm" | "fallback"
  txHash       String? @map("tx_hash")
  error        String?
  ts           Int

  @@index([circleId, id])
  @@map("agent_logs")
}

/// A member's standing instruction to the bidding agent for one circle.
model Mandate {
  circleId       Int     @map("circle_id")
  member         String
  goal           String
  maxDiscountPct Float?  @map("max_discount_pct")
  desiredPayout  String? @map("desired_payout") // wei as decimal string
  urgency        String? // "low" | "medium" | "high"
  riskTolerance  String? @map("risk_tolerance") // "low" | "medium" | "high"
  active         Boolean @default(true)
  createdAt      Int     @map("created_at")

  @@id([circleId, member])
  @@map("mandates")
}

model RiskCache {
  addr String @id @map("address")
  json String @map("result_json")
  ts   Int

  @@map("risk_cache")
}

model DemoSkip {
  addr String  @id @map("address")
  skip Boolean

  @@map("demo_skip")
}

model DemoCircle {
  circleId  Int @id @map("circle_id")
  createdAt Int @map("created_at")

  @@map("demo_circles")
}

model Meta {
  key   String @id
  value String

  @@map("meta")
}

// ───────────── v3: wallet login, roles, audit, support ─────────────
enum Role {
  MEMBER
  ORGANIZER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TicketStatus {
  OPEN
  CLOSED
}

/// One row per wallet that has signed in (address stored lowercase). Role is re-read on every request.
model User {
  walletAddress String     @id @map("wallet_address")
  role          Role       @default(MEMBER)
  status        UserStatus @default(ACTIVE)
  displayName   String?    @map("display_name")
  /// Public username (normalized lowercase, unique). The wallet address stays the on-chain identity.
  username      String?    @unique
  /// Lookalike key (0→o, 1→l, 3→e, 5→s, 7→t, underscores removed) so "rahul" and "rahu1" cannot both exist.
  usernameKey   String?    @unique @map("username_key")
  createdAt     Int        @map("created_at")
  lastLogin     Int?       @map("last_login")

  @@map("users")
}

/// One-time login nonce (SIWE-style). Consumed by setting used_at.
model AuthNonce {
  nonce         String @id
  walletAddress String @map("wallet_address")
  issuedAt      Int    @map("issued_at")
  expiresAt     Int    @map("expires_at")
  usedAt        Int?   @map("used_at")

  @@index([walletAddress, issuedAt])
  @@map("auth_nonces")
}

/// Bearer session; id = JWT jti. Logout / suspension set revoked_at.
model Session {
  id            String @id
  walletAddress String @map("wallet_address")
  role          Role
  createdAt     Int    @map("created_at")
  expiresAt     Int    @map("expires_at")
  revokedAt     Int?   @map("revoked_at")

  @@index([walletAddress])
  @@map("sessions")
}

/// Off-chain metadata for a circle (name, organizer). The contract remains the authority for funds/state.
model CircleMeta {
  circleId        Int     @id @map("circle_id")
  name            String
  description     String?
  organizerWallet String  @map("organizer_wallet")
  demo            Boolean @default(false)
  createdAt       Int     @map("created_at")

  @@index([organizerWallet])
  @@map("circle_meta")
}

model CircleInvite {
  circleId      Int    @map("circle_id")
  walletAddress String @map("wallet_address")
  invitedBy     String @map("invited_by")
  createdAt     Int    @map("created_at")

  @@id([circleId, walletAddress])
  @@index([walletAddress])
  @@map("circle_invites")
}

/// Application audit log (who did what on the website/backend). Blockchain events remain the authority for chain state.
model AuditLog {
  id          Int     @id @default(autoincrement())
  ts          Int
  actorWallet String? @map("actor_wallet")
  role        String
  action      String
  target      String?
  result      String
  txHash      String? @map("tx_hash")
  metaJson    String? @map("meta_json")

  @@index([ts])
  @@index([actorWallet])
  @@index([action])
  @@map("audit_log")
}

model SupportTicket {
  id         Int          @id @default(autoincrement())
  userWallet String       @map("user_wallet")
  subject    String
  message    String
  status     TicketStatus @default(OPEN)
  adminNote  String?      @map("admin_note")
  createdAt  Int          @map("created_at")
  updatedAt  Int          @map("updated_at")

  @@index([userWallet])
  @@index([status])
  @@map("support_tickets")
}

// ───────────── v4: autonomous AI bidding agent (crew proposes, Node guards and executes) ─────────────
/// One autonomous bidding strategy for a custodial demo wallet in one circle. Amounts are wei strings.
model BidAgent {
  id             String       @id @default(cuid())
  userWallet     String       @map("user_wallet") // session user (lowercase) who activated it
  circleId       Int          @map("circle_id")
  member         String // custodial demo wallet address (lowercase)
  goal           String
  desiredPayout  String?      @map("desired_payout") // wei string
  maxDiscount    String       @map("max_discount") // wei string (hard cap on any bid)
  maxDiscountPct Float        @map("max_discount_pct") // 0-50
  urgency        String // low|medium|high
  riskTolerance  String       @map("risk_tolerance") // low|medium|high
  durationSec    Int?         @map("duration_sec") // null = until the auction ends
  autonomous     Boolean      @default(false) // user granted auto-bid permission
  demoMode       Boolean      @default(false) @map("demo_mode")
  status         String       @default("ACTIVE") // ACTIVE|PAUSED|STOPPED|DONE|ERROR
  statusReason   String?      @map("status_reason")
  lastDecision   String?      @map("last_decision") // WAIT|BID|STOP
  lastReason     String?      @map("last_reason")
  lastBid        String?      @map("last_bid") // wei
  lastTxHash     String?      @map("last_tx_hash")
  failures       Int          @default(0)
  startedAt      Int          @map("started_at")
  expiresAt      Int?         @map("expires_at")
  updatedAt      Int          @map("updated_at")
  events         AgentEvent[]

  @@index([circleId, status])
  @@map("bid_agents")
}

/// Activity line for a BidAgent (short operational text + user-facing reason; never chain-of-thought).
model AgentEvent {
  id      Int      @id @default(autoincrement())
  agentId String   @map("agent_id")
  agent   BidAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ts      Int
  kind    String // REFRESH|BID_SEEN|EVALUATED|DECISION|RISK_PASSED|RISK_BLOCKED|TX_SUBMITTED|TX_CONFIRMED|TX_FAILED|PAUSED|STOPPED|DONE|RIVAL_BID|INFO
  text    String
  reason  String?
  data    Json?

  @@index([agentId, id])
  @@map("agent_events")
}
