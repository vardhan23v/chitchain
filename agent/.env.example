# Groq API key (LiteLLM inside CrewAI reads it). Never commit the real value.
GROQ_API_KEY=
# Node backend base URL (public auction endpoints are read through it)
CHITCHAIN_API_URL=http://localhost:4000
# LiteLLM model id
MODEL=groq/qwen/qwen3.8-27b
# Railway sets PORT; local default for uvicorn is 8000
PORT=8000
